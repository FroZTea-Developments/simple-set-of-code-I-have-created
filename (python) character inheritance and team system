class Character:
    def __init__(self, name):
        self._name = name
        self._health = 100

    def __str__(self):
        return f"{self._name} has {self._health} Health"

    def get_name(self):
        return self._name

    def get_health(self):
        return self._health
    
    def set_health(self, amount):
        self._health = amount

class Warrior(Character):
    def __init__(self, name):
        super().__init__(name)
        self._rage = 100

    def __str__(self):
        return f"{self._name} is a Warrior who has {self._health} Health and {self._rage} Rage"

    def remove_rage(self, amount):
        self._rage -= amount

    def add_rage(self, amount):
        self._rage += amount     
    
    def attack(self):
        print(f"{self._name} Attacks with their Weapon!")
        self.remove_rage(10)

    def rest(self):
        print(f"{self.name} rests for a turn.")
        self.add_rage(15)

class Mage(Character):
    def __init__(self, name):
        super().__init__(name)
        self._mana = 100

    def __str__(self):
        return f"{self._name} is a Mage who has {self._health} Health and {self._mana} Mana"

    def remove_mana(self, amount):
        self._mana -= amount

    def add_mana(self, amount):
        self._mana += amount     
    
    def attack(self):
        print(f"{self._name} Begins To Cast a Spell!")
        self.remove_mana(10)

    def rest(self):
        print(f"{self.name} rests for a turn")
        self.add_mana(15)
        
